# Copy this file to .env and fill in your keys.
# SeatGeek: sign up at https://seatgeek.com/account/develop (use the Client ID)
SEATGEEK_CLIENT_ID=
# Optional: the client secret SeatGeek issues when it approves price data access
SEATGEEK_CLIENT_SECRET=
# Ticketmaster: sign up at https://developer.ticketmaster.com (use the Consumer Key)
TICKETMASTER_API_KEY=
